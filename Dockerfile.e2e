# syntax=docker/dockerfile:1

# E2E image: the PHP runtime + Composer + Node 20, so the playwright-php suite
# can drive a real headless browser against the in-process Symfony kernel.
# Browser binaries and their OS dependencies are installed at run time (they
# need vendor/ in place first) and cached in the ms-playwright volume.
FROM dunglas/frankenphp:1-php8.3

RUN install-php-extensions intl opcache zip

COPY --from=composer/composer:2-bin /composer /usr/bin/composer

# Node 20+ — the bundled Playwright server requires it.
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

ENV APP_ENV=test
WORKDIR /app
